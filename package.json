{
  "name": "@afcms/jotai-devframe",
  "version": "0.0.0",
  "description": "An experimental Devframe based devtools for Jotai",
  "homepage": "https://github.com/AFCMS/jotai-devframe#readme",
  "bugs": {
    "url": "https://github.com/AFCMS/jotai-devframe/issues"
  },
  "license": "MIT",
  "author": "AFCMS <afcm.contact@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AFCMS/jotai-devframe.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@e18e/eslint-plugin": "^0.8.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "bumpp": "^12.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "preact": "^11.0.1",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "preact": "^11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "error"
    }
  }
}
